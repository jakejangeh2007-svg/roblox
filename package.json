{
  "name": "voxelcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first WebGL voxel survival game (Minecraft-style) built with Three.js and TypeScript",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.166.0"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
